{
  "name": "@tplnet/overkiz-client",
  "displayName": "Overkiz API Client",
  "version": "1.3.0",
  "description": "Overkiz API client for Node (maintained fork of dubocr/overkiz-client)",
  "author": "Romain DUBOC",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tplnet/overkiz-client.git"
  },
  "bugs": {
    "url": "https://github.com/tplnet/overkiz-client/issues"
  },
  "engines": {
    "node": ">=12.4.0"
  },
  "main": "dist/index.js",
  "scripts": {
    "lint": "eslint src/**.ts",
    "test": "npm run build && node --es-module-specifier-resolution=node ./dist/test.js",
    "clean": "rimraf ./dist",
    "build": "rimraf ./dist && tsc",
    "prepublishOnly": "npm run lint && npm run build"
  },
  "keywords": [
    "tahoma",
    "cozytouch"
  ],
  "homepage": "https://github.com/tplnet/overkiz-client#readme",
  "dependencies": {
    "axios": "^1.21.1",
    "bonjour": "^3.5.1",
    "events": "^3.3.0",
    "uuid": "^14.0.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.1.2",
    "@typescript-eslint/eslint-plugin": "^8.65.0",
    "@typescript-eslint/parser": "^8.65.0",
    "dotenv": "^17.4.2",
    "eslint": "^10.8.0",
    "nodemon": "^3.1.14",
    "rimraf": "^6.1.3",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3"
  },
  "contributors": [
    "tplnet (fork maintainer)"
  ],
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "overrides": {
    "minimatch": "^11.0.8"
  }
}
