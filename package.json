{
  "name": "overkiz-client",
  "displayName": "Overkiz API Client",
  "version": "1.0.21",
  "description": "Overkiz API client plugin for Node",
  "author": "Romain DUBOC",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git://github.com/dubocr/overkiz-client.git"
  },
  "bugs": {
    "url": "http://github.com/dubocr/overkiz-client/issues"
  },
  "engines": {
    "node": ">=12.4.0"
  },
  "main": "dist/index.js",
  "scripts": {
    "lint": "eslint src/**.ts",
    "test": "npm run build && node --es-module-specifier-resolution=node ./dist/test.js",
    "clean": "rimraf ./dist",
    "build": "rimraf ./dist && tsc",
    "prepublishOnly": "npm run lint && npm run build && npm version patch --m 'Release %s'",
    "postpublish": "npm run clean"
  },
  "keywords": [
    "tahoma",
    "cozytouch"
  ],
  "homepage": "https://github.com/dubocr/overkiz-client#readme",
  "dependencies": {
    "axios": "^1.7.2",
    "bonjour": "^3.5.0",
    "events": "^3.3.0",
    "uuid": "^14.0.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^14.17.5",
    "@typescript-eslint/eslint-plugin": "^8.65.0",
    "@typescript-eslint/parser": "^8.65.0",
    "dotenv": "^8.6.0",
    "eslint": "^10.8.0",
    "nodemon": "^3.1.14",
    "rimraf": "^6.1.3",
    "ts-node": "^10.9.1",
    "typescript": "^5.9.3"
  }
}
